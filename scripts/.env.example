# Supabase Configuration for Question Import Script
# Copy this file to .env and fill in your actual values

# Supabase Project URL
SUPABASE_URL=your-project-url.supabase.co

# Service Role Key (recommended for admin operations)
# This key bypasses Row Level Security and should be kept secure
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anonymous Key (fallback option)
# This key respects Row Level Security policies
SUPABASE_ANON_KEY=your-anon-key

# Alternative variable names (used by frontend)
# The script will use these if the above are not set
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key